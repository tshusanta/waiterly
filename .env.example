# Copy to .env for local dev, or set these in Vercel > Project > Settings > Environment Variables.
# Never commit a real key. Both are optional:
#   ANTHROPIC_API_KEY set  -> Claude (Haiku 5.5 for parsing, Sonnet 5.5 for the summary)
#   else GEMINI_API_KEY    -> Gemini 2.5 Flash
#   neither                -> FALLBACK MODE (keyword parser, rule-based planner, stats summary)
ANTHROPIC_API_KEY=
GEMINI_API_KEY=
